"""
heading_numbering_panel — 标题编号配置面板

设计文档: implementation_plan.md

纵向布局:
  ┌─ 顶部: 级数 + 预设 + [简单 组合 专家] ─┐
  ├─ 预览表 (永远可见): 层级 | 预览 | 目录  ─┤
  ├─ 编辑区 (组合/专家 展开)                 ─┤
  ├─ 非编号标题 (可折叠)                     ─┤
  └──────────────────────────────────────────┘

KI 合规: control_height_md=36, get_theme(), on_theme_changed(),
         setObjectName(), QSizePolicy, QScrollArea, :disabled,
         blockSignals+setParent(None)
"""

from __future__ import annotations

from PyQt5.QtCore import Qt
from PyQt5.QtWidgets import (
    QCheckBox,
    QComboBox,
    QFrame,
    QGridLayout,
    QHBoxLayout,
    QLabel,
    QLineEdit,
    QPushButton,
    QScrollArea,
    QSizePolicy,
    QVBoxLayout,
    QWidget,
)

from src.config.heading_presets import get_preset_labels
from src.shared.ui.theme import get_theme, on_theme_changed
from src.ui.adapters.heading_numbering_adapter import HeadingNumberingAdapter
from src.ui.base_panel import BasePanel

# ── 组合模式选项 (key 对齐引擎 _CORE_STYLE_AUTO_EXPAND) ──

_CORE_STYLE_OPTIONS = [
    ("arabic",          "1 2 3"),
    ("arabic_paren",    "1) 2) 3)"),
    ("chinese_lower",   "一 二 三"),
    ("chinese_upper",   "壹 贰 叁"),
    ("chinese_chapter", "第一章"),
    ("chinese_section", "第一节"),
    ("chinese_paren",   "(一)"),
    ("roman_upper",     "Ⅰ Ⅱ Ⅲ"),
    ("roman_lower",     "ⅰ ⅱ ⅲ"),
    ("circled",         "① ② ③"),
    ("alpha_upper",     "A B C"),
    ("alpha_lower",     "a b c"),
]

_SHELL_OPTIONS = [
    ("第{cn}章", "第{}章"),
    ("第{cn}节", "第{}节"),
    ("（{cn}）", "（{}）"),
    ("({cn})",   "({})"),
    ("{cn}、",   "{}、"),
    ("{nn})",    "N)"),
    ("{nn}.",    "N."),
    ("{nn}",     "N"),
    ("{cc}",     "①"),
]

_CHAIN_OPTIONS = [
    ("current_only",            "仅当前"),
    ("parent.current",          "上级.当前"),
    ("parent.parent.current",   "上上级.上级.当前"),
]

_MODE_SIMPLE = 0
_MODE_COMBO = 1
_MODE_EXPERT = 2


class HeadingNumberingPanel(BasePanel):
    """标题编号配置面板。"""

    panel_title = "标题编号"
    panel_icon = "hash"

    # ━━ 初始化 ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

    def _setup_ui(self) -> None:
        self.setObjectName("HeadingNumberingPanel")
        self._adapter = HeadingNumberingAdapter(parent=self)
        self._current_mode = _MODE_SIMPLE
        self._preview_rows: list[dict] = []

        root = QVBoxLayout(self)
        root.setContentsMargins(0, 0, 0, 0)
        root.setSpacing(0)

        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setFrameShape(QFrame.NoFrame)
        root.addWidget(scroll)

        content = QWidget()
        scroll.setWidget(content)
        self._main_layout = QVBoxLayout(content)
        self._main_layout.setContentsMargins(16, 12, 16, 12)
        self._main_layout.setSpacing(12)

        self._build_header()
        self._build_preview_table()
        self._build_edit_area()
        self._build_non_numbered_section()
        self._main_layout.addStretch(1)

        self._apply_theme()
        on_theme_changed(self._apply_theme)

    # ━━ 1. 顶部 ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

    def _build_header(self) -> None:
        t = get_theme()
        row = QWidget()
        h = QHBoxLayout(row)
        h.setContentsMargins(0, 0, 0, 0)
        h.setSpacing(12)

        # 标题级数
        h.addWidget(self._label("标题级数"))
        self._levels_cb = QComboBox()
        self._levels_cb.setFixedHeight(t.control_height_md)
        for i in range(1, 9):
            self._levels_cb.addItem(f"{i} 级", i)
        self._levels_cb.setCurrentIndex(3)
        h.addWidget(self._levels_cb)

        # 预设方案
        h.addWidget(self._label("预设方案"))
        self._preset_cb = QComboBox()
        self._preset_cb.setFixedHeight(t.control_height_md)
        self._preset_cb.setMinimumWidth(120)
        for key, label in get_preset_labels():
            self._preset_cb.addItem(label, key)
        self._preset_cb.addItem("自定义", "__custom__")
        # "自定义" 不可手动选中
        model = self._preset_cb.model()
        last = model.item(self._preset_cb.count() - 1)
        last.setEnabled(False)
        h.addWidget(self._preset_cb)

        h.addStretch(1)

        # 模式切换 [简单|组合|专家]
        self._mode_btns: list[QPushButton] = []
        for idx, text in enumerate(["简单", "组合", "专家"]):
            btn = QPushButton(text)
            btn.setObjectName("hn_mode_btn")
            btn.setCheckable(True)
            btn.setFixedHeight(t.control_height_md)
            btn.setMinimumWidth(52)
            btn.setChecked(idx == 0)
            btn.clicked.connect(lambda _, i=idx: self._on_mode_changed(i))
            h.addWidget(btn)
            self._mode_btns.append(btn)

        self._main_layout.addWidget(row)

    # ━━ 2. 预览表 (永远可见) ━━━━━━━━━━━━━━━━━━━━━

    def _build_preview_table(self) -> None:
        self._preview_frame = QFrame()
        self._preview_frame.setObjectName("hn_table_frame")
        self._preview_grid = QGridLayout(self._preview_frame)
        self._preview_grid.setContentsMargins(0, 0, 0, 0)
        self._preview_grid.setSpacing(0)
        self._main_layout.addWidget(self._preview_frame)

    def _rebuild_preview(self) -> None:
        _clear_layout(self._preview_grid)
        self._preview_rows.clear()
        t = get_theme()
        levels = self._adapter.max_levels if self._adapter._template else 4

        # 表头
        for col, (text, stretch) in enumerate([
            ("层级", 0), ("预览", 1), ("目录", 0),
        ]):
            lbl = QLabel(text)
            lbl.setObjectName("hn_col_header")
            lbl.setFixedHeight(t.control_height_md)
            lbl.setAlignment(Qt.AlignCenter)
            self._preview_grid.addWidget(lbl, 0, col)
            if stretch:
                self._preview_grid.setColumnStretch(col, 1)

        previews = (
            self._adapter.preview_all() if self._adapter._template
            else [(i, "") for i in range(1, levels + 1)]
        )
        for i, (level, text) in enumerate(previews):
            row = i + 1

            # 层级标签
            lv_lbl = QLabel(f"H{level}")
            lv_lbl.setObjectName("hn_level_label")
            lv_lbl.setFixedHeight(t.control_height_md)
            lv_lbl.setAlignment(Qt.AlignCenter)
            lv_lbl.setFixedWidth(48)
            self._preview_grid.addWidget(lv_lbl, row, 0)

            # 预览
            pv_lbl = QLabel(text or "—")
            pv_lbl.setObjectName("hn_preview")
            pv_lbl.setFixedHeight(t.control_height_md)
            pv_lbl.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)
            self._preview_grid.addWidget(pv_lbl, row, 1)

            # 目录
            toc = QCheckBox()
            b = self._adapter.get_binding(level) if self._adapter._template else None
            toc.setChecked(b.include_in_toc if b else True)
            toc.toggled.connect(lambda c, lv=level: self._on_toc(lv, c))
            wrap = QWidget()
            wl = QHBoxLayout(wrap)
            wl.setContentsMargins(0, 0, 0, 0)
            wl.setAlignment(Qt.AlignCenter)
            wl.addWidget(toc)
            wrap.setFixedHeight(t.control_height_md)
            self._preview_grid.addWidget(wrap, row, 2)

            self._preview_rows.append({
                "level": level, "preview": pv_lbl, "toc": toc,
            })

    # ━━ 3. 编辑区 (组合/专家) ━━━━━━━━━━━━━━━━━━━━

    def _build_edit_area(self) -> None:
        self._edit_frame = QFrame()
        self._edit_frame.setObjectName("hn_edit_frame")
        self._edit_layout = QVBoxLayout(self._edit_frame)
        self._edit_layout.setContentsMargins(0, 8, 0, 0)
        self._edit_layout.setSpacing(4)
        self._edit_frame.setVisible(False)
        self._main_layout.addWidget(self._edit_frame)

    def _rebuild_edit(self) -> None:
        _clear_layout(self._edit_layout)
        if self._current_mode == _MODE_SIMPLE:
            self._edit_frame.setVisible(False)
            return
        self._edit_frame.setVisible(True)
        t = get_theme()
        levels = self._adapter.max_levels if self._adapter._template else 4

        title_text = "组合编辑" if self._current_mode == _MODE_COMBO else "模板编辑"
        title = QLabel(title_text)
        title.setObjectName("hn_edit_title")
        title.setFixedHeight(t.control_height_md)
        self._edit_layout.addWidget(title)

        for level in range(1, levels + 1):
            b = self._adapter.get_binding(level) if self._adapter._template else None
            self._edit_layout.addWidget(
                self._make_edit_row(level, b, t)
            )

    def _make_edit_row(self, level: int, b, t) -> QWidget:
        row = QWidget()
        h = QHBoxLayout(row)
        h.setContentsMargins(0, 0, 0, 0)
        h.setSpacing(8)

        lbl = QLabel(f"H{level}")
        lbl.setObjectName("hn_level_label")
        lbl.setFixedHeight(t.control_height_md)
        lbl.setFixedWidth(36)
        lbl.setAlignment(Qt.AlignCenter)
        h.addWidget(lbl)

        if self._current_mode == _MODE_COMBO:
            self._add_combo_fields(h, level, b, t)
        else:
            self._add_expert_fields(h, level, b, t)
        return row

    def _add_combo_fields(self, layout, level, b, t) -> None:
        pairs = [
            ("外壳", _SHELL_OPTIONS, "display_template", True),
            ("样式", _CORE_STYLE_OPTIONS, "display_core_style", False),
            ("引用时", _CORE_STYLE_OPTIONS, "reference_core_style", False),
            ("链", _CHAIN_OPTIONS, "chain", False),
        ]
        for label_text, options, field, has_custom in pairs:
            layout.addWidget(self._small_label(label_text))
            cb = QComboBox()
            cb.setFixedHeight(t.control_height_md)
            cb.setMinimumWidth(80)
            for val, disp in options:
                cb.addItem(disp, val)
            if has_custom:
                cb.addItem("自定义", "__custom__")
            if b:
                _select(cb, getattr(b, field, None))
            cb.currentIndexChanged.connect(
                lambda _, lv=level, f=field, c=cb: self._on_field(lv, f, c.currentData())
            )
            layout.addWidget(cb)

        # 分隔符
        layout.addWidget(self._small_label("间距"))
        sep = QLineEdit()
        sep.setFixedHeight(t.control_height_md)
        sep.setFixedWidth(40)
        sep.setAlignment(Qt.AlignCenter)
        if b:
            sep.setText(b.title_separator or "")
        sep.textChanged.connect(
            lambda text, lv=level: self._on_field(lv, "title_separator", text)
        )
        layout.addWidget(sep)
        layout.addStretch(1)

    def _add_expert_fields(self, layout, level, b, t) -> None:
        layout.addWidget(self._small_label("template"))
        tmpl = QLineEdit()
        tmpl.setFixedHeight(t.control_height_md)
        tmpl.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)
        if b:
            tmpl.setText(b.display_template or "")
        tmpl.textChanged.connect(
            lambda text, lv=level: self._on_field(lv, "display_template", text)
        )
        layout.addWidget(tmpl)

        layout.addWidget(self._small_label("chain"))
        chain = QLineEdit()
        chain.setFixedHeight(t.control_height_md)
        chain.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Fixed)
        if b:
            chain.setText(b.chain or "")
        chain.textChanged.connect(
            lambda text, lv=level: self._on_field(lv, "chain", text)
        )
        layout.addWidget(chain)

    # ━━ 4. 非编号标题 (折叠区) ━━━━━━━━━━━━━━━━━━━

    def _build_non_numbered_section(self) -> None:
        t = get_theme()

        # 折叠标题
        self._nn_toggle = QPushButton("▸ 非编号标题")
        self._nn_toggle.setObjectName("hn_section_toggle")
        self._nn_toggle.setFixedHeight(t.control_height_md)
        self._nn_toggle.setFlat(True)
        self._nn_toggle.clicked.connect(self._toggle_non_numbered)
        self._main_layout.addWidget(self._nn_toggle)

        # 折叠内容
        self._nn_frame = QFrame()
        self._nn_frame.setObjectName("hn_nn_frame")
        nn_layout = QVBoxLayout(self._nn_frame)
        nn_layout.setContentsMargins(12, 4, 0, 4)
        nn_layout.setSpacing(8)

        # 精确匹配
        nn_layout.addWidget(self._small_label("精确匹配 (标题文本完全一致即跳过编号)"))
        self._nn_texts_edit = QLineEdit()
        self._nn_texts_edit.setFixedHeight(t.control_height_md)
        self._nn_texts_edit.setPlaceholderText("参考文献, 致谢, 摘要, ...")
        nn_layout.addWidget(self._nn_texts_edit)

        # 前缀匹配
        nn_layout.addWidget(self._small_label("前缀匹配 (标题以此开头即跳过)"))
        self._nn_prefix_edit = QLineEdit()
        self._nn_prefix_edit.setFixedHeight(t.control_height_md)
        self._nn_prefix_edit.setPlaceholderText("附录, 附件, Appendix, ...")
        nn_layout.addWidget(self._nn_prefix_edit)

        self._nn_frame.setVisible(False)
        self._main_layout.addWidget(self._nn_frame)

    def _toggle_non_numbered(self) -> None:
        vis = not self._nn_frame.isVisible()
        self._nn_frame.setVisible(vis)
        self._nn_toggle.setText(("▾" if vis else "▸") + " 非编号标题")

    def _sync_non_numbered_ui(self) -> None:
        if not self._adapter._template:
            return
        texts = self._adapter.get_non_numbered_texts()
        self._nn_texts_edit.blockSignals(True)
        self._nn_texts_edit.setText(", ".join(texts))
        self._nn_texts_edit.blockSignals(False)

        prefixes = self._adapter.get_non_numbered_prefixes()
        self._nn_prefix_edit.blockSignals(True)
        self._nn_prefix_edit.setText(", ".join(prefixes))
        self._nn_prefix_edit.blockSignals(False)

    # ━━ 信号处理 ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

    def _on_mode_changed(self, idx: int) -> None:
        self._current_mode = idx
        for i, btn in enumerate(self._mode_btns):
            btn.setChecked(i == idx)
        self._rebuild_edit()

    def _on_preset_changed(self, index: int) -> None:
        key = self._preset_cb.itemData(index)
        if not key or key == "__custom__" or not self._adapter._template:
            return
        self._adapter.apply_preset(key)
        self._rebuild_preview()
        self._rebuild_edit()

    def _on_levels_changed(self, index: int) -> None:
        val = self._levels_cb.itemData(index)
        if val and self._adapter._template:
            self._adapter.set_max_levels(val)
            self._rebuild_preview()
            self._rebuild_edit()

    def _on_field(self, level: int, field: str, value) -> None:
        if value is None or not self._adapter._template:
            return
        self._adapter.set_binding_field(level, field, value)
        self._sync_preset_display()
        self._refresh_previews()

    def _on_toc(self, level: int, checked: bool) -> None:
        if self._adapter._template:
            self._adapter.set_binding_field(level, "include_in_toc", checked)

    def _on_nn_texts_changed(self, text: str) -> None:
        if self._adapter._template:
            items = [s.strip() for s in text.split(",") if s.strip()]
            self._adapter.set_non_numbered_texts(items)

    def _on_nn_prefix_changed(self, text: str) -> None:
        if self._adapter._template:
            items = [s.strip() for s in text.split(",") if s.strip()]
            self._adapter.set_non_numbered_prefixes(items)

    # ━━ 同步 ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

    def _sync_preset_display(self) -> None:
        if not self._adapter._template:
            return
        key = self._adapter.detect_active_preset()
        self._preset_cb.blockSignals(True)
        if key:
            for i in range(self._preset_cb.count()):
                if self._preset_cb.itemData(i) == key:
                    self._preset_cb.setCurrentIndex(i)
                    break
        else:
            self._preset_cb.setCurrentIndex(self._preset_cb.count() - 1)
        self._preset_cb.blockSignals(False)

    def _refresh_previews(self) -> None:
        if not self._adapter._template:
            return
        for row in self._preview_rows:
            text = self._adapter.preview_number(row["level"])
            row["preview"].setText(text or "—")

    # ━━ 生命周期 ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

    def _connect_signals(self) -> None:
        self._levels_cb.currentIndexChanged.connect(self._on_levels_changed)
        self._preset_cb.currentIndexChanged.connect(self._on_preset_changed)
        self._nn_texts_edit.textChanged.connect(self._on_nn_texts_changed)
        self._nn_prefix_edit.textChanged.connect(self._on_nn_prefix_changed)

    def on_template_changed(self, template) -> None:
        self._adapter.set_template(template)
        self._levels_cb.blockSignals(True)
        self._levels_cb.setCurrentIndex(
            max(0, min(self._adapter.max_levels - 1, 7))
        )
        self._levels_cb.blockSignals(False)
        self._rebuild_preview()
        self._sync_preset_display()
        self._rebuild_edit()
        self._sync_non_numbered_ui()

    # ━━ 小工具 ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

    @staticmethod
    def _label(text: str) -> QLabel:
        lbl = QLabel(text)
        lbl.setObjectName("hn_header_label")
        return lbl

    @staticmethod
    def _small_label(text: str) -> QLabel:
        lbl = QLabel(text)
        lbl.setObjectName("hn_field_label")
        return lbl

    # ━━ 主题 ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

    def _apply_theme(self) -> None:
        t = get_theme()
        self.setStyleSheet(f"""
            #HeadingNumberingPanel {{ background: {t.bg_card}; }}

            #hn_header_label {{
                font-size: {t.font_size_lg}px;
                font-weight: {t.font_weight_bold};
                color: {t.text_primary};
            }}

            #hn_table_frame, #hn_edit_frame, #hn_nn_frame {{
                background: {t.bg_card};
                border: {t.border_width_sm}px solid {t.border};
                border-radius: {t.radius_sm}px;
            }}

            #hn_col_header {{
                font-size: {t.font_size_sm}px;
                font-weight: {t.font_weight_bold};
                color: {t.text_secondary};
                background: {t.bg_input};
                border-bottom: {t.border_width_sm}px solid {t.border};
                padding: 0 {t.spacing_sm}px;
            }}

            #hn_level_label {{
                font-size: {t.font_size_md}px;
                font-weight: {t.font_weight_bold};
                color: {t.primary};
            }}
            #hn_preview {{
                font-size: {t.font_size_md}px;
                color: {t.text_primary};
                padding: 0 {t.spacing_sm}px;
            }}
            #hn_edit_title {{
                font-size: {t.font_size_md}px;
                font-weight: {t.font_weight_bold};
                color: {t.text_secondary};
                padding: 4px {t.spacing_sm}px;
            }}
            #hn_field_label {{
                font-size: {t.font_size_sm}px;
                color: {t.text_secondary};
            }}
            #hn_section_toggle {{
                font-size: {t.font_size_md}px;
                font-weight: {t.font_weight_bold};
                color: {t.text_secondary};
                text-align: left;
                padding: 0 {t.spacing_sm}px;
            }}

            #hn_mode_btn {{
                font-size: {t.font_size_sm}px;
                border: {t.border_width_sm}px solid {t.border};
                padding: 0 {t.spacing_sm}px;
                background: {t.bg_input};
                color: {t.text_secondary};
            }}
            #hn_mode_btn:checked {{
                background: {t.primary};
                color: {t.text_on_primary};
                border-color: {t.primary};
            }}

            QComboBox {{
                font-size: {t.font_size_md}px;
                border: {t.border_width_sm}px solid {t.border};
                border-radius: {t.radius_sm}px;
                padding: 0 {t.spacing_sm}px;
                background: {t.bg_input};
                color: {t.text_primary};
            }}
            QComboBox:hover {{ border-color: {t.border_focus}; }}
            QComboBox:disabled {{ background: {t.bg_hover}; color: {t.text_disabled}; }}

            QLineEdit {{
                font-size: {t.font_size_md}px;
                border: {t.border_width_sm}px solid {t.border};
                border-radius: {t.radius_sm}px;
                padding: 0 {t.spacing_sm}px;
                background: {t.bg_input};
                color: {t.text_primary};
            }}
            QLineEdit:focus {{ border-color: {t.border_focus}; }}
            QLineEdit:disabled {{ background: {t.bg_hover}; color: {t.text_disabled}; }}

            QCheckBox:disabled {{ color: {t.text_disabled}; }}
        """)


# ── 模块级工具函数 ───────────────────────────────

def _clear_layout(layout) -> None:
    """安全清除布局: blockSignals 防 zombie 信号, setParent(None) 立即释放。"""
    while layout.count():
        item = layout.takeAt(0)
        w = item.widget()
        if w:
            w.blockSignals(True)
            w.setParent(None)


def _select(combo: QComboBox, value) -> None:
    """根据 data 选中 combo 项。"""
    for i in range(combo.count()):
        if combo.itemData(i) == value:
            combo.setCurrentIndex(i)
            return
