      "italic": false,
      "alignment": "justify",
      "first_line_indent_chars": 2,
      "first_line_indent_unit": "chars",
      "left_indent_chars": 0,
      "left_indent_unit": "chars",
      "right_indent_chars": 0,
      "right_indent_unit": "chars",
      "hanging_indent_chars": 0,
      "hanging_indent_unit": "chars",
      "special_indent_mode": "none",
      "special_indent_value": 0,
      "special_indent_unit": "chars",
      "line_spacing_type": "exact",
      "line_spacing_pt": 20,
      "space_before_pt": 0,
      "space_before_unit": "pt",
      "space_after_pt": 0,
      "space_after_unit": "pt"
    },
    "heading": {
      "font_cn": "宋体",
      "font_en": "Times New Roman",
      "size_pt": 12,
      "size_display": "小四",
      "bold": true,
      "italic": false,
      "alignment": "left",
      "first_line_indent_chars": 0,
      "first_line_indent_unit": "chars",
      "left_indent_chars": 0,
      "left_indent_unit": "chars",
      "right_indent_chars": 0,
      "right_indent_unit": "chars",
      "hanging_indent_chars": 0,
      "hanging_indent_unit": "chars",
      "special_indent_mode": "none",
      "special_indent_value": 0,
      "special_indent_unit": "chars",
      "line_spacing_type": "exact",
      "line_spacing_pt": 20,
      "space_before_pt": 0,
      "space_before_unit": "pt",
      "space_after_pt": 0,
      "space_after_unit": "pt"
    }
  },
  "heading_numbering": {
    "shell_catalog": {},
    "core_style_catalog": {},
    "chain_catalog": {},
    "preset_catalog": {},
    "level_bindings": {
      "heading1": {
        "enabled": true,
        "display_shell": "plain",
