  "heading_model": {
    "level_to_word_style": {
      "heading1": "Heading 1",
      "heading2": "Heading 2",
      "heading3": "Heading 3",
      "heading4": "Heading 4",
      "heading5": "Heading 5",
      "heading6": "Heading 6",
      "heading7": "Heading 7",
      "heading8": "Heading 8"
    },
    "style_alias_to_level": {
      "一级标题": "heading1",
      "二级标题": "heading2",
      "三级标题": "heading3",
      "四级标题": "heading4",
      "五级标题": "heading5",
      "六级标题": "heading6",
      "七级标题": "heading7",
      "八级标题": "heading8",
      "章标题": "heading1",
      "节标题": "heading2",
      "标题 1": "heading1",
      "标题 2": "heading2",
      "标题 3": "heading3",
      "标题 4": "heading4"
    },
    "max_heading_levels": 4,
    "non_numbered_title_texts": [
      "参考文献",
      "勘误页",
      "勘误",
      "致谢",
      "个人简历",
      "在学期间发表的学术论文与研究成果",
      "摘要",
      "Abstract",
      "目录"
    ],
    "non_numbered_prefixes": [
      "附录",
      "附件",
      "Appendix"
    ],
    "non_numbered_heading_style_name": "Heading 1 Unnumbered",
    "non_numbered_heading_style_mode": "inherit_heading1"
  },
  "section": {
    "section_break_type": null
  },
  "table": {
    "layout_mode": "smart",
    "smart_levels": 4,
    "border_mode": "three_line",
    "border_width_pt": 0.5,
    "three_line_header_width_pt": 1.0,
    "three_line_bottom_width_pt": 0.5,
    "color_table_accent": "blue",
    "color_table_variant": "header_grid",
    "line_spacing_mode": "single",
    "repeat_header": false,
    "font_cn": "微软雅黑",
    "font_en": "Times New Roman",
    "size_pt": 10.5,
    "bold": false,
    "italic": false,
    "table_alignment": "center",
    "cell_alignment": null,
    "first_row_bold": false
  },
  "header_footer": {
    "header": {
      "enabled": true,
      "mode": "styleref",
      "fixed_text": "",
      "alignment": "center",
      "styleref_level": 1,
      "border": true,
      "border_style": {
        "enabled": true,
        "line_style": "single",
        "width_pt": 0.5,
        "spacing_pt": 1.0,
        "color": "auto"
      },
      "hide_on_cover": true,
      "typography": {
        "font_cn": null,
        "font_en": null,
        "size_pt": null,
        "bold": false,
        "italic": false
      }
    },
    "footer": {
      "enabled": true,
      "content_mode": "page_number",
      "fixed_text": "",
      "alignment": "center",
      "page_number_template": "{page}",
      "hide_on_cover": true,
      "typography": {
        "font_cn": null,
        "font_en": null,
        "size_pt": null,
        "bold": false,
        "italic": false
      }
    },
    "behavior": {
      "different_first_page": false,
      "different_odd_even_pages": false,
      "link_to_previous": "never",
      "preserve_existing_content": false
    },
    "variants": {
      "default": {
        "header": {
          "mode": "inherit",
          "fixed_text": "",
          "template": "",
          "alignment": "center",
          "styleref_level": 1,
          "styleref_style": "",
          "styleref_include_number": true
        },
        "footer": {
          "mode": "inherit",
          "fixed_text": "",
          "template": "",
          "alignment": "center",
          "styleref_level": 1,
          "styleref_style": "",
          "styleref_include_number": true
        }
      },
      "first": {
        "header": {
          "mode": "none",
          "fixed_text": "",
          "template": "",
          "alignment": "center",
          "styleref_level": 1,
          "styleref_style": "",
          "styleref_include_number": true
        },
        "footer": {
          "mode": "none",
          "fixed_text": "",
          "template": "",
          "alignment": "center",
          "styleref_level": 1,
          "styleref_style": "",
          "styleref_include_number": true
        }
      },
      "even": {
        "header": {
          "mode": "inherit",
          "fixed_text": "",
          "template": "",
          "alignment": "center",
          "styleref_level": 1,
          "styleref_style": "",
          "styleref_include_number": true
        },
        "footer": {
          "mode": "inherit",
          "fixed_text": "",
          "template": "",
          "alignment": "center",
          "styleref_level": 1,
          "styleref_style": "",
          "styleref_include_number": true
        }
      }
    },
    "page_number_plan": {
      "phases": [
        {
          "phase_id": "main",
          "selectors": [
            "all_numbered_content"
          ],
          "visible": true,
          "number_format": "decimal",
          "start_mode": "restart",
          "start_value": 1
        }
      ],
      "on_missing_doc_tree": "warn_and_fallback",
      "validation_mode": "strict"
    },
    "suppress_header_footer_selectors": [
      "pre_numbering"
    ]
  },
  "toc": {
    "mode": "word_native",
    "max_level": 3,
    "insert_position": "auto"
  },
  "caption": {
    "figure_prefix": "图",
    "table_prefix": "表",
    "separator": "　",
    "placeholder": "[待补充]",
    "numbering_format": "chapter.seq",
    "numbering_mode": "chapter",
    "auto_insert": true,
    "format_inserted": false
  },
  "formula_table": {
    "formula_font_name": "Times New Roman",
    "formula_font_size_pt": 12.0,
    "formula_font_size_display": "12",
