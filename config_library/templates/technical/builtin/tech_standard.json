{
  "name": "通用技术文档",
  "description": "适用于技术方案、设计说明和操作手册的内置模板。",
  "page_setup": {
    "paper_size": "A4",
    "orientation": "portrait",
    "margin": {
      "top_cm": 2.5,
      "bottom_cm": 2.5,
      "left_cm": 3.2,
      "right_cm": 3.2
    },
    "gutter_cm": 0,
    "header_distance_cm": 3.0,
    "footer_distance_cm": 3.0
