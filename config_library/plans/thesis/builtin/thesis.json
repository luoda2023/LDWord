{
  "name": "论文排版",
  "description": "中文学位论文·课程论文·综述·开题",
  "category": "academic",
  "category_label": "学术文档",
  "scene_id": "thesis",
  "mode_id": "thesis",
  "display_order": 30,
  "template_id": "thesis_gbt",
  "compatible_template_ids": [
    "thesis_gbt",
    "thesis_custom"
  ],
  "master_id": "",
  "document_scope": {
    "mode": "all",
    "selected_roles": []
  },
  "module_switches": {
    "page_setup": true,
    "section_format": true,
    "paragraph_style": true,
    "header_footer": true,
    "heading_recognition": true,
    "heading_numbering": true,
    "toc": true,
    "caption": true,
    "table_format": true,
    "figure_table_center": true,
    "entity_fill": false,
    "source_fill": false,
    "placeholder_replace": false,
    "image_insertion": false,
    "watermark": false,
    "md_cleanup": true,
    "whitespace_normalize": true,
    "validation": true,
    "citation_link": true,
    "reference_format": true
  },
  "input_source_profile": {
    "accepted_formats": [
      "docx",
      "markdown"
    ],
    "structured_formats": [
      "json"
    ],
    "markdown_policy": "preview_and_cleanup",
    "latex_policy": "formula_fragments_only",
    "require_material_package": false,
    "material_schema_id": "thesis_school_rule_context_v1",
    "material_schema_ids": [
      "thesis_school_rule_context_v1"
    ],
    "required_material_fields": [],
    "required_image_roles": [],
    "high_risk_imports": [
      "full_latex_project"
    ],
    "failure_policy": "warn"
  },
  "compliance_profile": {
    "profile_id": "thesis_cn",
    "rule_family": "academic_thesis",
    "count_profile_id": "school_thesis",
    "enabled_checks": [
      "validation",
      "object_preflight"
    ],
    "check_scopes": [
      "abstract_cn",
      "abstract_en",
      "body",
      "references",
      "tables",
      "figures",
      "appendix"
    ],
    "report_level": "detailed",
    "failure_policy": "warn",
    "object_preflight": {
      "enabled": true,
      "preservation_mode": "warn",
      "scan_targets": [
        "ole_objects",
        "embedded_workbooks",
        "embedded_packages",
        "visio_drawings",
        "macros",
        "tracked_changes",
        "comments",
        "hidden_text",
        "textboxes",
        "content_controls",
        "fields"
      ],
      "block_on": [
        "macros"
      ],
      "skip_high_risk_modules": true,
      "skip_modules_by_finding": {
        "ole_objects": [
          "section_format"
        ],
        "embedded_workbooks": [
          "section_format"
        ],
        "visio_drawings": [
          "section_format"
        ],
        "macros": [
          "section_format"
        ]
      }
    }
  },
  "default_delivery_preset_id": "final",
  "delivery_presets": [
    {
      "preset_id": "final",
      "label": "Final manuscript",
      "target_template_id": "thesis_gbt",
      "output_dir_template": "{document_dir}/output",
      "filename_template": "{stem}_{preset_id}",
      "artifacts": {
        "final_docx": true,
        "compare_docx": false,
        "compare_text": false,
        "compare_formatting": false,
        "report_json": true,
        "report_markdown": true,
        "material_manifest": false,
        "material_package": false,
        "review_pdf": false
      },
      "content_visibility_rules": [],
      "include_structured_intermediate": false,
      "report_level": "summary"
    },
    {
      "preset_id": "review",
      "label": "Review copy",
      "target_template_id": "thesis_gbt",
      "output_dir_template": "{document_dir}/output",
      "filename_template": "{stem}_{preset_id}",
      "artifacts": {
        "final_docx": true,
        "compare_docx": true,
        "compare_text": true,
        "compare_formatting": true,
        "report_json": true,
        "report_markdown": true,
        "material_manifest": false,
        "material_package": false,
        "review_pdf": false
      },
      "content_visibility_rules": [],
      "include_structured_intermediate": true,
      "report_level": "detailed"
    },
    {
      "preset_id": "compliance_report",
      "label": "Compliance report",
      "target_template_id": "thesis_gbt",
      "output_dir_template": "{document_dir}/output",
      "filename_template": "{stem}_{preset_id}",
      "artifacts": {
        "final_docx": false,
        "compare_docx": false,
        "compare_text": false,
        "compare_formatting": false,
        "report_json": true,
        "report_markdown": true,
        "material_manifest": false,
        "material_package": false,
        "review_pdf": false
      },
      "content_visibility_rules": [],
      "include_structured_intermediate": false,
      "report_level": "detailed"
    }
  ],
  "exam_paper": {
    "question_structure_mode": "markdown_headings",
    "answer_policy": "student_plus_answer",
    "custom_blank_styles": [],
    "runtime_fields": [
      "title",
      "subject",
      "grade",
      "duration",
      "total_score"
    ]
  },
  "md_cleanup": {
    "preserve_existing_word_lists": true,
    "formula_copy_noise_cleanup": true,
    "suppress_formula_fake_lists": true,
    "list_marker_separator": "tab",
    "ordered_list_style": "mixed",
    "unordered_list_style": "word_default"
  },
  "whitespace": {
    "normalize_space_variants": true,
    "convert_tabs": true,
    "remove_zero_width": true,
    "collapse_multiple_spaces": true,
    "trim_paragraph_edges": true,
    "smart_full_half_convert": true,
    "punctuation_by_context": true,
    "bracket_by_inner_language": true,
    "fullwidth_alnum_to_halfwidth": true,
    "quote_by_context": false,
    "protect_reference_numbering": true,
    "context_min_confidence": 2
  },
  "citation_link": {
    "auto_number_reference_entries": true,
    "superscript_outer_page_numbers": false
  },
  "reference_style": {
    "hanging_indent_cm": 0.74,
    "space_after_pt": 0,
    "space_after_unit": "pt",
    "font_cn": null,
    "font_en": null,
    "size_pt": null
  },
  "watermark": {
    "enabled": false,
    "text": "",
    "color": "#C0C0C0",
    "rotation": -45,
    "font_size": 48
  },
  "template_overrides": {},
  "batch_preset": null,
  "strict_mode": true,
  "thesis_formula_rules": {
    "formula_enabled": true,
    "formula_convert": {
      "enabled": true,
      "output_mode": "word_native",
      "low_confidence_policy": "skip_and_mark",
      "office_fallback_enabled": false,
      "office_fallback_timeout_sec": 30
    },
    "formula_to_table": {
      "enabled": true,
      "block_only": true
    },
    "formula_table": {
      "formula_font_name": "Cambria Math",
      "formula_font_size_pt": 12.0,
      "formula_font_size_display": "",
      "formula_line_spacing": 1.0,
      "formula_space_before_pt": 0.0,
      "formula_space_before_unit": "pt",
      "formula_space_after_pt": 0.0,
      "formula_space_after_unit": "pt",
      "block_alignment": "center",
      "table_alignment": "center",
      "formula_cell_alignment": "center",
      "number_alignment": "right",
      "number_font_name": "Times New Roman",
      "number_font_size_pt": 10.5,
      "number_font_size_display": "",
      "auto_shrink_number_column": true
    },
    "formula_style": {
      "enabled": true,
      "unify_font": true,
      "unify_size": true,
      "unify_spacing": true
    },
    "equation_numbering": {
      "enabled": true,
      "numbering_format": "chapter.seq"
    },
    "chem_typography": {
      "enabled": false,
      "western_font": "Times New Roman",
      "scopes": {
        "references": false,
        "body": false,
        "headings": false,
        "abstract_cn": false,
        "abstract_en": false,
        "captions": false,
        "tables": false
      },
      "allow_tokens": [],
      "allow_patterns": [],
      "ignore_tokens": [],
      "ignore_patterns": [],
      "manual_overrides": {}
    }
  }
}
