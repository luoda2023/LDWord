{
  "name": "公文基础方案",
  "description": "政府公文通用处理规则；本次任务文种在工作台独立选择。",
  "category": "government",
  "category_label": "政府公文",
  "scene_id": "official",
  "mode_id": "official",
  "display_order": 50,
  "template_id": "official_gbt",
  "compatible_template_ids": [
    "official_gbt",
    "official_custom"
  ],
  "master_id": "official_gbt_standard",
  "document_scope": {
    "mode": "all",
    "selected_roles": []
  },
  "module_switches": {
    "page_setup": true,
    "section_format": true,
    "paragraph_style": true,
    "header_footer": true,
    "heading_recognition": true,
    "heading_numbering": true,
    "toc": true,
    "caption": true,
    "table_format": true,
    "figure_table_center": true,
    "entity_fill": true,
    "source_fill": true,
    "placeholder_replace": true,
    "image_insertion": true,
    "watermark": true,
    "md_cleanup": true,
    "whitespace_normalize": true,
    "validation": true,
    "citation_link": false,
    "reference_format": false
  },
  "input_source_profile": {
    "accepted_formats": [
      "docx"
    ],
    "structured_formats": [
      "json"
    ],
    "markdown_policy": "disabled",
    "latex_policy": "disabled",
    "require_material_package": true,
    "material_schema_id": "official_document_v1",
    "material_schema_ids": [
      "official_document_v1"
    ],
    "required_material_fields": [
      "title",
      "body",
      "organization",
      "document_no",
      "issue_date"
    ],
    "required_image_roles": [],
    "high_risk_imports": [
      "full_latex_project"
    ],
    "failure_policy": "warn"
  },
  "compliance_profile": {
    "profile_id": "official_document",
    "rule_family": "official_document",
    "count_profile_id": "",
    "enabled_checks": [
      "validation",
      "object_preflight"
    ],
    "check_scopes": [
      "body",
      "headers_footers",
      "metadata"
    ],
    "report_level": "summary",
    "failure_policy": "warn",
    "object_preflight": {
      "enabled": true,
      "preservation_mode": "warn",
      "scan_targets": [
        "ole_objects",
        "embedded_workbooks",
        "embedded_packages",
        "visio_drawings",
        "macros",
        "tracked_changes",
        "comments",
        "hidden_text",
        "textboxes",
        "content_controls",
        "fields"
      ],
      "block_on": [
        "macros"
      ],
      "skip_high_risk_modules": true,
      "skip_modules_by_finding": {
        "ole_objects": [
          "section_format"
        ],
        "embedded_workbooks": [
          "section_format"
        ],
        "visio_drawings": [
          "section_format"
        ],
        "macros": [
          "section_format"
        ]
      }
    }
  },
  "default_delivery_preset_id": "formal",
  "delivery_presets": [
    {
      "preset_id": "formal",
      "label": "Formal copy",
      "target_template_id": "official_gbt",
      "output_dir_template": "{document_dir}/output",
      "filename_template": "{stem}_{preset_id}",
      "artifacts": {
        "final_docx": true,
        "compare_docx": false,
        "compare_text": false,
        "compare_formatting": false,
        "report_json": true,
        "report_markdown": true,
        "material_manifest": false,
        "material_package": false,
        "review_pdf": true
      },
      "content_visibility_rules": [],
      "include_structured_intermediate": false,
      "report_level": "summary"
    },
    {
      "preset_id": "internal_review",
      "label": "Internal review",
      "target_template_id": "official_gbt",
      "output_dir_template": "{document_dir}/output",
      "filename_template": "{stem}_{preset_id}",
      "artifacts": {
        "final_docx": true,
        "compare_docx": true,
        "compare_text": true,
        "compare_formatting": true,
        "report_json": true,
        "report_markdown": true,
        "material_manifest": false,
        "material_package": false,
        "review_pdf": true
      },
      "content_visibility_rules": [],
      "include_structured_intermediate": false,
      "report_level": "summary"
    }
  ],
  "exam_paper": {
    "question_structure_mode": "markdown_headings",
    "answer_policy": "student_plus_answer",
    "custom_blank_styles": [],
    "runtime_fields": [
      "title",
      "subject",
      "grade",
      "duration",
      "total_score"
    ]
  },
  "md_cleanup": {
    "preserve_existing_word_lists": true,
    "formula_copy_noise_cleanup": true,
    "suppress_formula_fake_lists": true,
    "list_marker_separator": "tab",
    "ordered_list_style": "mixed",
    "unordered_list_style": "word_default"
  },
  "whitespace": {
    "normalize_space_variants": true,
    "convert_tabs": true,
    "remove_zero_width": true,
    "collapse_multiple_spaces": true,
    "trim_paragraph_edges": true,
    "smart_full_half_convert": true,
    "punctuation_by_context": true,
    "bracket_by_inner_language": true,
    "fullwidth_alnum_to_halfwidth": true,
    "quote_by_context": false,
    "protect_reference_numbering": true,
    "context_min_confidence": 2
  },
  "citation_link": {
    "auto_number_reference_entries": true,
    "superscript_outer_page_numbers": false
  },
  "reference_style": {
    "hanging_indent_cm": 0.74,
    "space_after_pt": 0,
    "space_after_unit": "pt"
  },
  "watermark": {
    "enabled": false,
    "text": "",
    "color": "#C0C0C0",
    "rotation": -45,
    "font_size": 48
  },
  "template_overrides": {},
  "batch_preset": null,
  "strict_mode": false,
  "thesis_formula_rules": null
}
