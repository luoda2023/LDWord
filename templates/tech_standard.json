{
  "name": "通用技术文档",
  "description": "适用于技术方案、设计说明和操作手册的内置模板。",
  "page_setup": {
    "paper_size": "A4",
    "orientation": "portrait",
    "margin": {
      "top_cm": 2.5,
      "bottom_cm": 2.5,
      "left_cm": 3.2,
      "right_cm": 3.2
    },
    "gutter_cm": 0,
    "header_distance_cm": 3.0,
    "footer_distance_cm": 3.0
  },
  "styles": {
    "body": {
      "font_cn": "宋体",
      "font_en": "Times New Roman",
      "size_pt": 12,
      "size_display": "小四",
      "bold": false,
      "italic": false,
      "alignment": "justify",
      "first_line_indent_chars": 2,
      "first_line_indent_unit": "chars",
      "left_indent_chars": 0,
      "left_indent_unit": "chars",
      "right_indent_chars": 0,
      "right_indent_unit": "chars",
      "hanging_indent_chars": 0,
      "hanging_indent_unit": "chars",
      "line_spacing_type": "exact",
      "line_spacing_pt": 20,
      "space_before_pt": 0,
      "space_after_pt": 0
    }
  },
  "heading_numbering": {
    "shell_catalog": {},
    "core_style_catalog": {},
    "chain_catalog": {},
    "preset_catalog": {},
    "level_bindings": {}
  },
  "heading_model": {
    "level_to_word_style": {
      "heading1": "Heading 1",
      "heading2": "Heading 2",
      "heading3": "Heading 3",
      "heading4": "Heading 4",
      "heading5": "Heading 5",
      "heading6": "Heading 6",
      "heading7": "Heading 7",
      "heading8": "Heading 8"
    },
    "style_alias_to_level": {
      "一级标题": "heading1",
      "二级标题": "heading2",
      "三级标题": "heading3",
      "四级标题": "heading4",
      "五级标题": "heading5",
      "六级标题": "heading6",
      "七级标题": "heading7",
      "八级标题": "heading8",
      "章标题": "heading1",
      "节标题": "heading2",
      "标题 1": "heading1",
      "标题 2": "heading2",
      "标题 3": "heading3",
      "标题 4": "heading4"
    },
    "max_heading_levels": 4,
    "non_numbered_title_texts": [
      "参考文献",
      "勘误页",
      "勘误",
      "致谢",
      "个人简历",
      "在学期间发表的学术论文与研究成果",
      "摘要",
      "Abstract",
      "目录"
    ],
    "non_numbered_prefixes": [
      "附录",
      "附件",
      "Appendix"
    ],
    "non_numbered_heading_style_name": "Heading 1 Unnumbered"
  },
  "section": {
    "section_break_type": null
  }
}