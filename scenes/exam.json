{
  "name": "试卷",
  "description": "把 Markdown 或 Word 题目内容装配成完整试卷",
  "category": "exam_paper",
  "category_label": "试卷",
  "scene_id": "exam",
  "template_id": "default",
  "default_template_id": "default",
  "compatible_template_ids": [
    "default"
  ],
  "application_boundary": {
    "mode": "follow_template",
    "confirm_before_apply": false
  },
  "format_scope": {
    "mode": "auto",
    "page_ranges_text": "",
    "body_start_index": null,
    "body_start_page": null,
    "body_start_keyword": "",
    "sections": {
      "body": true,
      "toc": false,
      "references": false,
      "appendix": false,
      "acknowledgment": false,
      "abstract_cn": false,
      "abstract_en": false,
      "errata": false,
      "resume": false
    }
  },
  "available_sections": [
    "body",
    "references",
    "errata",
    "acknowledgment",
    "appendix",
    "resume",
    "abstract_cn",
    "abstract_en",
    "toc"
  ],
  "module_switches": {
    "page_setup": true,
    "section_format": true,
    "paragraph_style": true,
    "header_footer": true,
    "heading_recognition": true,
    "heading_numbering": true,
    "toc": true,
    "caption": true,
    "table_format": true,
    "figure_table_center": true,
    "entity_fill": false,
    "source_fill": false,
    "placeholder_replace": false,
    "image_insertion": false,
    "watermark": false,
    "chem_typography": true,
    "md_cleanup": true,
    "whitespace_normalize": true,
    "validation": true,
    "citation_link": false,
    "equation_table_format": true,
    "reference_format": false
  },
  "input_source_profile": {
    "accepted_formats": [
      "markdown",
      "docx"
    ],
    "structured_formats": [
      "json"
    ],
    "markdown_policy": "preview_and_cleanup",
    "latex_policy": "formula_fragments_only",
    "require_material_package": false,
    "material_schema_id": "",
    "material_schema_ids": [],
    "required_material_fields": [],
    "required_image_roles": [],
    "high_risk_imports": [
      "full_latex_project"
    ],
    "failure_policy": "warn"
  },
  "compliance_profile": {
    "profile_id": "exam_paper",
    "rule_family": "exam_paper",
    "count_profile_id": "",
    "enabled_checks": [
      "validation",
      "object_preflight"
    ],
    "check_scopes": [
      "body",
      "tables",
      "figures"
    ],
    "report_level": "summary",
    "failure_policy": "warn",
    "object_preflight": {
      "enabled": true,
      "preservation_mode": "warn",
      "scan_targets": [
        "ole_objects",
        "embedded_workbooks",
        "embedded_packages",
        "visio_drawings",
        "macros",
        "tracked_changes",
        "comments",
        "hidden_text",
        "textboxes",
        "content_controls",
        "fields"
      ],
      "block_on": [
        "macros",
        "ole_objects"
      ],
      "skip_high_risk_modules": true,
      "skip_modules_by_finding": {
        "ole_objects": [
          "section_format"
        ],
        "embedded_workbooks": [
          "section_format"
        ],
        "visio_drawings": [
          "section_format"
        ],
        "macros": [
          "section_format"
        ]
      }
    }
  },
  "default_delivery_preset_id": "student",
  "delivery_presets": [
    {
      "preset_id": "student",
      "label": "学生卷",
      "target_template_id": "default",
      "output_dir_template": "{document_dir}/output",
      "filename_template": "{stem}_{preset_id}",
      "artifacts": {
        "final_docx": true,
        "compare_docx": false,
        "compare_text": false,
        "compare_formatting": false,
        "report_json": true,
        "report_markdown": true,
        "material_manifest": false,
        "material_package": false
      },
      "content_visibility_rules": [
        {
          "rule_id": "hide_answers",
          "label": "隐藏答案与解析",
          "selector_type": "semantic_block",
          "selector": "answer",
          "action": "remove"
        },
        {
          "rule_id": "hide_explanations",
          "label": "隐藏解析",
          "selector_type": "semantic_block",
          "selector": "explanation",
          "action": "remove"
        }
      ],
      "include_structured_intermediate": false,
      "report_level": "summary"
    },
    {
      "preset_id": "answer",
      "label": "答案版",
      "target_template_id": "default",
      "output_dir_template": "{document_dir}/output",
      "filename_template": "{stem}_{preset_id}",
      "artifacts": {
        "final_docx": true,
        "compare_docx": false,
        "compare_text": false,
        "compare_formatting": false,
        "report_json": true,
        "report_markdown": true,
        "material_manifest": false,
        "material_package": false
      },
      "content_visibility_rules": [],
      "include_structured_intermediate": false,
      "report_level": "summary"
    }
  ],
  "md_cleanup": {
    "preserve_existing_word_lists": true,
    "formula_copy_noise_cleanup": true,
    "suppress_formula_fake_lists": true,
    "list_marker_separator": "tab",
    "ordered_list_style": "mixed",
    "unordered_list_style": "word_default"
  },
  "whitespace": {
    "normalize_space_variants": true,
    "convert_tabs": true,
    "remove_zero_width": true,
    "collapse_multiple_spaces": true,
    "trim_paragraph_edges": true,
    "smart_full_half_convert": true,
    "punctuation_by_context": true,
    "bracket_by_inner_language": true,
    "fullwidth_alnum_to_halfwidth": true,
    "quote_by_context": false,
    "protect_reference_numbering": true,
    "context_min_confidence": 2
  },
  "citation_link": {
    "auto_number_reference_entries": true,
    "superscript_outer_page_numbers": false
  },
  "formula_convert": {
    "output_mode": "word_native",
    "low_confidence_policy": "skip_and_mark",
    "office_fallback_enabled": false,
    "office_fallback_timeout_sec": 30
  },
  "chem_typography": {
    "western_font": "Times New Roman",
    "scopes": {
      "references": false,
      "body": false,
      "headings": false,
      "abstract_cn": false,
      "abstract_en": false,
      "captions": false,
      "tables": false
    },
    "allow_tokens": [],
    "allow_patterns": [],
    "ignore_tokens": [],
    "ignore_patterns": [],
    "manual_overrides": {}
  },
  "table": {
    "layout_mode": "smart",
    "smart_levels": 4,
    "border_mode": "full_grid",
    "border_width_pt": 0.5,
    "three_line_header_width_pt": 1.0,
    "three_line_bottom_width_pt": 0.5,
    "color_table_accent": "blue",
    "color_table_variant": "header_grid",
    "line_spacing_mode": "single",
    "repeat_header": false,
    "font_cn": "微软雅黑",
    "font_en": "Times New Roman",
    "size_pt": 10.5,
    "bold": false,
    "italic": false,
    "table_alignment": "center",
    "cell_alignment": null,
    "first_row_bold": false
  },
  "header_footer": {
    "header": {
      "enabled": true,
      "mode": "styleref",
      "fixed_text": "",
      "alignment": "center",
      "styleref_level": 1,
      "border": true,
      "border_style": {
        "enabled": true,
        "line_style": "single",
        "width_pt": 0.5,
        "spacing_pt": 1.0,
        "color": "auto"
      },
      "hide_on_cover": true,
      "typography": {
        "font_cn": null,
        "font_en": null,
        "size_pt": null,
        "bold": false,
        "italic": false
      }
    },
    "footer": {
      "enabled": true,
      "content_mode": "page_number",
      "fixed_text": "",
      "alignment": "center",
      "page_number_template": "{page}",
      "hide_on_cover": true,
      "typography": {
        "font_cn": null,
        "font_en": null,
        "size_pt": null,
        "bold": false,
        "italic": false
      }
    },
    "behavior": {
      "different_first_page": false,
      "different_odd_even_pages": false,
      "link_to_previous": "never",
      "preserve_existing_content": false
    },
    "variants": {
      "default": {
        "header": {
          "mode": "inherit",
          "fixed_text": "",
          "template": "",
          "alignment": "center",
          "styleref_level": 1,
          "styleref_style": "",
          "styleref_include_number": true
        },
        "footer": {
          "mode": "inherit",
          "fixed_text": "",
          "template": "",
          "alignment": "center",
          "styleref_level": 1,
          "styleref_style": "",
          "styleref_include_number": true
        }
      },
      "first": {
        "header": {
          "mode": "none",
          "fixed_text": "",
          "template": "",
          "alignment": "center",
          "styleref_level": 1,
          "styleref_style": "",
          "styleref_include_number": true
        },
        "footer": {
          "mode": "none",
          "fixed_text": "",
          "template": "",
          "alignment": "center",
          "styleref_level": 1,
          "styleref_style": "",
          "styleref_include_number": true
        }
      },
      "even": {
        "header": {
          "mode": "inherit",
          "fixed_text": "",
          "template": "",
          "alignment": "center",
          "styleref_level": 1,
          "styleref_style": "",
          "styleref_include_number": true
        },
        "footer": {
          "mode": "inherit",
          "fixed_text": "",
          "template": "",
          "alignment": "center",
          "styleref_level": 1,
          "styleref_style": "",
          "styleref_include_number": true
        }
      }
    },
    "page_number_plan": {
      "phases": [],
      "on_missing_doc_tree": "warn_and_fallback",
      "validation_mode": "strict"
    },
    "suppress_header_footer_selectors": [
      "pre_numbering"
    ]
  },
  "toc": {
    "mode": "word_native",
    "enabled": true,
    "max_level": 3,
    "insert_position": "auto"
  },
  "caption": {
    "figure_prefix": "图",
    "table_prefix": "表",
    "separator": "　",
    "placeholder": "[待补充]",
    "numbering_format": "chapter.seq",
    "numbering_mode": "chapter",
    "auto_insert": true,
    "format_inserted": false
  },
  "formula_table": {
    "formula_font_name": "Times New Roman",
    "formula_font_size_pt": 12.0,
    "formula_font_size_display": "12",
    "formula_line_spacing": 1.0,
    "formula_space_before_pt": 6.0,
    "formula_space_before_unit": "pt",
    "formula_space_after_pt": 6.0,
    "formula_space_after_unit": "pt",
    "block_alignment": "center",
    "table_alignment": "center",
    "formula_cell_alignment": "center",
    "number_alignment": "right",
    "number_font_name": "Times New Roman",
    "number_font_size_pt": 12.0,
    "number_font_size_display": "12",
    "auto_shrink_number_column": true
  },
  "formula_style": {
    "unify_font": true,
    "unify_size": true,
    "unify_spacing": true
  },
  "equation_numbering": {
    "numbering_format": "chapter.seq"
  },
  "reference_style": {
    "hanging_indent_cm": 0.74,
    "space_after_pt": 0,
    "space_after_unit": "pt",
    "font_cn": null,
    "font_en": null,
    "size_pt": null
  },
  "watermark": {
    "enabled": false,
    "text": "",
    "color": "#C0C0C0",
    "rotation": -45,
    "font_size": 48
  },
  "section_styles": {},
  "output": {
    "final_docx": true,
    "compare_docx": true,
    "compare_text": true,
    "compare_formatting": true,
    "report_json": true,
    "report_markdown": true,
    "material_manifest": false,
    "material_package": false
  },
  "template_overrides": {},
  "batch_preset": null,
  "strict_mode": false
}