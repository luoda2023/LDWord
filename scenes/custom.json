{
  "name": "自定义",
  "description": "手动控制所有功能开关与处理范围",
  "category": "general",
  "category_label": "通用文档",
  "scene_id": "custom",
  "template_id": "default",
  "default_template_id": "default",
  "compatible_template_ids": [
    "default"
  ],
  "format_scope": {
    "body_start_keyword": "",
    "sections": {
      "body": true,
      "references": true,
      "errata": true,
      "acknowledgment": true,
      "appendix": true,
      "abstract_cn": true,
      "abstract_en": true,
      "toc": true,
      "resume": true
    }
  },
  "available_sections": [
    "body",
    "references",
    "errata",
    "acknowledgment",
    "appendix",
    "resume",
    "abstract_cn",
    "abstract_en",
    "toc"
  ],
  "input_source_profile": {
    "accepted_formats": ["docx", "markdown"],
    "structured_formats": ["json"],
    "markdown_policy": "cleanup_only",
    "latex_policy": "disabled",
    "require_material_package": false,
    "material_schema_id": "",
    "required_material_fields": [],
    "required_image_roles": [],
    "high_risk_imports": ["full_latex_project"],
    "failure_policy": "warn"
  },
  "compliance_profile": {
    "profile_id": "custom_basic",
    "rule_family": "manual",
    "count_profile_id": "",
    "enabled_checks": ["validation", "object_preflight"],
    "check_scopes": ["body", "references", "tables", "figures"],
    "report_level": "summary",
    "failure_policy": "warn",
    "object_preflight": {
      "enabled": true,
      "preservation_mode": "warn",
      "block_on": ["macros"],
      "skip_high_risk_modules": true
    }
  },
  "default_delivery_preset_id": "final",
  "delivery_presets": [
    {
      "preset_id": "final",
      "label": "Final DOCX",
      "target_template_id": "default",
      "output_dir_template": "{document_dir}/output",
      "filename_template": "{stem}_{preset_id}",
      "artifacts": {
        "final_docx": true,
        "compare_docx": false,
        "compare_text": false,
        "compare_formatting": false,
        "report_json": true,
        "report_markdown": true
      },
      "include_structured_intermediate": false,
      "report_level": "summary"
    }
  ],
  "module_switches": {
    "page_setup": true,
    "section_format": true,
    "paragraph_style": true,
    "header_footer": false,
    "heading_recognition": true,
    "heading_numbering": true,
    "toc": false,
    "caption": false,
    "table_format": false,
    "figure_table_center": false,
    "entity_fill": false,
    "source_fill": false,
    "placeholder_replace": false,
    "image_insertion": false,
    "watermark": false,
    "chem_typography": false,
    "md_cleanup": false,
    "whitespace_normalize": false,
    "validation": false,
    "citation_link": false,
    "equation_table_format": false,
    "reference_format": false
  },
  "md_cleanup": {
    "preserve_existing_word_lists": true,
    "formula_copy_noise_cleanup": true,
    "suppress_formula_fake_lists": true,
    "list_marker_separator": "tab",
    "ordered_list_style": "mixed",
    "unordered_list_style": "word_default"
  },
  "whitespace": {
    "normalize_space_variants": true,
    "convert_tabs": true,
    "remove_zero_width": true,
    "collapse_multiple_spaces": true,
    "trim_paragraph_edges": true,
    "smart_full_half_convert": true,
    "punctuation_by_context": true,
    "bracket_by_inner_language": true,
    "fullwidth_alnum_to_halfwidth": true,
    "quote_by_context": false,
    "protect_reference_numbering": true,
    "context_min_confidence": 2
  },
  "citation_link": {
    "auto_number_reference_entries": true,
    "superscript_outer_page_numbers": false
  },
  "formula_convert": {
    "output_mode": "word_native",
    "low_confidence_policy": "skip_and_mark",
    "office_fallback_enabled": false,
    "office_fallback_timeout_sec": 30
  },
  "chem_typography": {
    "western_font": "Times New Roman",
    "scopes": {
      "references": false,
      "body": false,
      "headings": false,
      "abstract_cn": false,
      "abstract_en": false,
      "captions": false,
      "tables": false
    },
    "allow_tokens": [],
    "allow_patterns": [],
    "ignore_tokens": [],
    "ignore_patterns": [],
    "manual_overrides": {}
  },
  "table": {
    "layout_mode": "smart",
    "smart_levels": 4,
    "border_mode": "three_line",
    "border_width_pt": 0.5,
    "three_line_header_width_pt": 1.0,
    "three_line_bottom_width_pt": 0.5,
    "line_spacing_mode": "single",
    "repeat_header": false,
    "font_cn": null,
    "font_en": null,
    "size_pt": null,
    "cell_alignment": null
  },
  "header_footer": {
    "header_mode": "styleref",
    "header_text": "",
    "header_border": true,
    "page_number_enabled": true,
    "styleref_level": 1,
    "font_cn": null,
    "font_en": null,
    "size_pt": null
  },
  "toc": {
    "mode": "word_native",
    "enabled": true,
    "max_level": 3,
    "insert_position": "auto"
  },
  "caption": {
    "figure_prefix": "图",
    "table_prefix": "表",
    "separator": "　",
    "placeholder": "[待补充]",
    "numbering_format": "chapter.seq",
    "numbering_mode": "chapter"
  },
  "formula_table": {
    "formula_font_name": "Times New Roman",
    "formula_font_size_pt": 12.0,
    "formula_font_size_display": "12",
    "formula_line_spacing": 1.0,
    "formula_space_before_pt": 6.0,
    "formula_space_after_pt": 6.0,
    "block_alignment": "center",
    "table_alignment": "center",
    "formula_cell_alignment": "center",
    "number_alignment": "right",
    "number_font_name": "Times New Roman",
    "number_font_size_pt": 12.0,
    "number_font_size_display": "12",
    "auto_shrink_number_column": true
  },
  "formula_style": {
    "unify_font": true,
    "unify_size": true,
    "unify_spacing": true
  },
  "equation_numbering": {
    "numbering_format": "chapter.seq"
  },
  "reference_style": {
    "hanging_indent_cm": 0.74,
    "space_after_pt": 0,
    "font_cn": null,
    "font_en": null,
    "size_pt": null
  },
  "watermark": {
    "enabled": false,
    "text": "",
    "color": "#C0C0C0",
    "rotation": -45,
    "font_size": 48
  },
  "section_styles": {},
  "output": {
    "final_docx": true,
    "compare_docx": true,
    "compare_text": true,
    "compare_formatting": true,
    "report_json": true,
    "report_markdown": true
  },
  "template_overrides": {},
  "batch_preset": null,
  "strict_mode": true
}
