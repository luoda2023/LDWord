{
  "name": "技术文档",
  "description": "技术规范·操作手册·设计文档",
  "category": "technical",
  "category_label": "技术文档",
  "scene_id": "technical",
  "template_id": "tech_standard",
  "default_template_id": "tech_standard",
  "compatible_template_ids": [
    "tech_standard",
    "tech_custom"
  ],
  "format_scope": {
    "body_start_keyword": "",
    "sections": {
      "body": true,
      "toc": true,
      "appendix": true,
      "references": false,
      "acknowledgment": false,
      "abstract_cn": false,
      "abstract_en": false,
      "errata": false,
      "resume": false
    }
  },
  "available_sections": [
    "body",
    "references",
    "errata",
    "acknowledgment",
    "appendix",
    "resume",
    "abstract_cn",
    "abstract_en",
    "toc"
  ],
  "module_switches": {
    "page_setup": true,
    "section_format": true,
    "paragraph_style": true,
    "header_footer": true,
    "heading_recognition": true,
    "heading_numbering": true,
    "toc": true,
    "caption": true,
    "table_format": true,
    "figure_table_center": true,
    "entity_fill": true,
    "source_fill": true,
    "placeholder_replace": true,
    "image_insertion": true,
    "watermark": true,
    "chem_typography": true,
    "md_cleanup": true,
    "equation_table_format": true,
    "reference_format": false
  },
  "md_cleanup": {
    "preserve_existing_word_lists": true,
    "formula_copy_noise_cleanup": true,
    "suppress_formula_fake_lists": true,
    "list_marker_separator": "tab",
    "ordered_list_style": "mixed",
    "unordered_list_style": "word_default"
  },
  "whitespace": {
    "normalize_space_variants": true,
    "convert_tabs": true,
    "remove_zero_width": true,
    "collapse_multiple_spaces": true,
    "trim_paragraph_edges": true,
    "smart_full_half_convert": true,
    "punctuation_by_context": true,
    "bracket_by_inner_language": true,
    "fullwidth_alnum_to_halfwidth": true,
    "quote_by_context": false,
    "protect_reference_numbering": true,
    "context_min_confidence": 2
  },
  "citation_link": {
    "auto_number_reference_entries": true,
    "superscript_outer_page_numbers": false
  },
  "formula_convert": {
    "output_mode": "word_native",
    "low_confidence_policy": "skip_and_mark",
    "office_fallback_enabled": false,
    "office_fallback_timeout_sec": 30
  },
  "chem_typography": {
    "western_font": "Times New Roman",
    "scopes": {
      "references": false,
      "body": false,
      "headings": false,
      "abstract_cn": false,
      "abstract_en": false,
      "captions": false,
      "tables": false
    },
    "allow_tokens": [],
    "allow_patterns": [],
    "ignore_tokens": [],
    "ignore_patterns": [],
    "manual_overrides": {}
  },
  "table": {
    "layout_mode": "smart",
    "smart_levels": 4,
    "border_mode": "full_grid",
    "border_width_pt": 0.5,
    "three_line_header_width_pt": 1.0,
    "three_line_bottom_width_pt": 0.5,
    "line_spacing_mode": "single",
    "repeat_header": false,
    "row_height_pt": null,
    "font_cn": null,
    "font_en": null,
    "size_pt": null,
    "cell_alignment": null
  },
  "header_footer": {
    "header_mode": "styleref",
    "header_text": "",
    "header_border": true,
    "page_number_enabled": true,
    "styleref_level": 1,
    "font_cn": null,
    "font_en": null,
    "size_pt": null
  },
  "toc": {
    "mode": "word_native",
    "enabled": true,
    "max_level": 3,
    "insert_position": "auto"
  },
  "caption": {
    "figure_prefix": "图",
    "table_prefix": "表",
    "separator": "　",
    "placeholder": "[待补充]",
    "numbering_format": "chapter.seq",
    "numbering_mode": "chapter"
  },
  "formula_table": {
    "formula_font_name": "Times New Roman",
    "formula_font_size_pt": 12.0,
    "formula_font_size_display": "12",
    "formula_line_spacing": 1.0,
    "formula_space_before_pt": 6.0,
    "formula_space_after_pt": 6.0,
    "block_alignment": "center",
    "table_alignment": "center",
    "formula_cell_alignment": "center",
    "number_alignment": "right",
    "number_font_name": "Times New Roman",
    "number_font_size_pt": 12.0,
    "number_font_size_display": "12",
    "auto_shrink_number_column": true
  },
  "formula_style": {
    "unify_font": true,
    "unify_size": true,
    "unify_spacing": true
  },
  "equation_numbering": {
    "numbering_format": "chapter.seq"
  },
  "reference_style": {
    "hanging_indent_cm": 0.74,
    "space_after_pt": 0,
    "font_cn": null,
    "font_en": null,
    "size_pt": null
  },
  "watermark": {
    "enabled": false,
    "text": "",
    "color": "#C0C0C0",
    "rotation": -45,
    "font_size": 48
  },
  "section_styles": {},
  "output": {
    "final_docx": true,
    "compare_docx": true,
    "compare_text": true,
    "compare_formatting": true,
    "report_json": true,
    "report_markdown": true
  },
  "template_overrides": {},
  "batch_preset": null,
  "strict_mode": true
}