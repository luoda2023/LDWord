    {
      "profile_id": "application_word_limits",
      "label": "Project application word limits",
      "scope": "application_body",
      "included_scopes": ["body", "tables"],
      "excluded_scopes": ["reference_heading", "references", "back_matter"],
      "primary_metrics": ["cjk_characters", "english_words", "characters_no_spaces"],
      "section_limits": [
        {
          "section_id": "summary",
          "label": "Project summary",
          "heading_patterns": ["摘要", "项目摘要", "summary"],
          "max_characters_no_spaces": 500,
          "required": true
        },
        {
          "section_id": "basis",
          "label": "Rationale and background",
          "heading_patterns": ["立项依据", "背景", "basis", "background"],
          "max_characters_no_spaces": 2000
        },
        {
          "section_id": "objectives",
          "label": "Objectives and scope",
          "heading_patterns": ["目标", "研究内容", "建设内容", "objectives", "scope"],
          "max_characters_no_spaces": 1500
        },
        {
          "section_id": "implementation",
          "label": "Implementation plan",
          "heading_patterns": ["实施方案", "实施计划", "技术路线", "implementation", "work plan"],
          "max_characters_no_spaces": 2500
        },
        {
          "section_id": "budget",
          "label": "Budget description",
          "heading_patterns": ["预算", "经费", "budget"],
          "max_characters_no_spaces": 1000
        }
      ],
      "notes": [
        "Attachment inventory is handled by a separate application profile.",
        "Section limits are first-pass defaults and should be overridden by reviewed application-specific rules when available."
      ]
    },
    {
      "profile_id": "attachment_inventory",
